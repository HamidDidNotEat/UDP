<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultimate Debloat Pack"
        Width="1000" Height="740" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar: wizard pages -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="#1F2937">
            <DockPanel Margin="0,18,0,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,12,18">
                    <Image x:Name="SidebarLogo" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UDP" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Ultimate Debloat Pack" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="18,0" FontSize="11" Foreground="#6B7280"/>
                <StackPanel x:Name="NavList" Margin="0,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Page area with the overlay used for briefings and questions during the run -->
        <Grid Grid.Column="1" Grid.Row="0">
            <ContentControl x:Name="PageHost" Margin="0"/>

            <Border x:Name="Overlay" Background="#CCF3F4F6" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" MaxWidth="700" Margin="30" Padding="22,18"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="OverlayTitle" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" FontSize="19"/>
                        <StackPanel x:Name="OverlayButtons" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,16,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <TextBlock x:Name="OverlayBody" Style="{StaticResource Body}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Embedded log panel -->
        <Expander x:Name="LogExpander" Grid.Column="1" Grid.Row="1" Header="Log" Margin="12,0,12,6"
                  FontSize="12" Foreground="{StaticResource MutedBrush}">
            <TextBox x:Name="LogBox" Height="170" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11.5" BorderThickness="0" Padding="8,6"
                     Background="{StaticResource LogBackBrush}" Foreground="{StaticResource LogTextBrush}"/>
        </Expander>

        <!-- Footer: status, progress and navigation -->
        <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="FooterStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="100" Margin="0,5,0,0"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Background="#E5E7EB"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Close" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
