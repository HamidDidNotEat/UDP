<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultimate Debloat Pack - before and after"
        Width="720" Height="580" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Image x:Name="Logo" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="What changed" Style="{StaticResource PageTitle}" Margin="0"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenFolderButton" Content="Open the reports folder" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="WaitPanel" Style="{StaticResource InfoBox}">
                    <StackPanel>
                        <TextBlock x:Name="WaitText" Style="{StaticResource Body}"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,2" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TableCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <Grid x:Name="Table"/>
                </Border>
                <TextBlock x:Name="Notes" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
