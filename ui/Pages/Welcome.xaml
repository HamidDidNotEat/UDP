<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock Text="Welcome to UDP" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="UDP runs a set of well-known debloat and privacy tools for you, one after another, from their official sources. Each page explains one tool and lets you choose what it does."/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What UDP does" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="1. Creates a System Restore point."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="2. Win11Debloat: removes preinstalled apps and applies privacy and usability tweaks."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="3. O&amp;O ShutUp10++: privacy settings, chosen by you or imported from your own exported file."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="4. Bulk Crap Uninstaller: you remove the desktop programs you do not want."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="5. Installs an alternative browser, optionally with privacy extensions."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="6. Removes Microsoft Edge (optional) and keeps WebView2."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="7. NVCleanstall: a lean NVIDIA driver (optional, NVIDIA graphics cards only)."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,1" Text="8. Autoruns: you review what still starts with Windows."/>
                <TextBlock Style="{StaticResource Body}" Text="Then a single restart at the very end."/>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Every tool is downloaded at run time from its official source and checked (digital signature or published checksum) before it runs. Nothing third-party is bundled with UDP."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource WarningBox}">
            <StackPanel>
                <TextBlock Text="Disclaimer" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                <TextBlock Style="{StaticResource Body}" Margin="0"
                           Text="UDP changes system settings, removes apps and can remove Microsoft Edge. It creates a restore point first, but some of these changes cannot be undone by UDP itself. Use it at your own risk: UDP and the authors of the tools it runs give no warranty."/>
            </StackPanel>
        </Border>

        <Border x:Name="PreflightWarnings" Style="{StaticResource WarningBox}" Visibility="Collapsed">
            <TextBlock x:Name="PreflightWarningsText" Style="{StaticResource Body}" Margin="0"/>
        </Border>

        <Border x:Name="LastRunBox" Style="{StaticResource InfoBox}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LastRunText" Style="{StaticResource Body}"/>
                <Button x:Name="OpenReportButton" Content="Open the before/after report" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,2,0,2" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="This PC" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <TextBlock x:Name="SystemInfo" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"/>
        </Border>

        <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="DryRunCheck" Content="Dry run: show what would happen, without changing anything"/>
        <TextBlock Style="{StaticResource Muted}" Margin="22,0,0,8"
                   Text="Tools are still downloaded and verified, Win11Debloat runs in preview mode (-WhatIf), and every other change is only written to the log. No restore point is created and no tool window is opened."/>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <Button x:Name="RevertPoliciesButton" Content="Revert browser policies created by UDP" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                   Text="UDP keeps a small file, C:\ProgramData\UDP\state.json. Please do not delete it: UDP needs it to undo the browser policies it set and to show your before/after report."/>

        <CheckBox x:Name="AgreeCheck" Margin="0,8,0,0" FontWeight="SemiBold">
            <TextBlock TextWrapping="Wrap" Text="I have read the disclaimer and I use UDP at my own risk."/>
        </CheckBox>
    </StackPanel>
</ScrollViewer>
