<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock x:Name="FinishTitle" Text="All done" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="FinishSubtitle" Style="{StaticResource PageSubtitle}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel x:Name="ResultsPanel"/>
        </Border>

        <TextBlock Text="Log file" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="LogPathText" Style="{StaticResource Body}" FontFamily="Consolas" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
            <Button x:Name="OpenLogButton" Content="Open log folder" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>

        <Border x:Name="RebootPanel" Style="{StaticResource InfoBox}">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}"
                           Text="Restart Windows once to apply everything. UDP suppressed the restart prompts of the individual tools so that this is the only restart."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <Button x:Name="RebootNowButton" Content="Restart now" Style="{StaticResource PrimaryButton}" Margin="0"/>
                    <Button x:Name="RebootLaterButton" Content="Restart later" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
