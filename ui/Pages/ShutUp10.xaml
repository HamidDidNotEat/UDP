<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock Text="O&amp;O ShutUp10++" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="By O&amp;O Software. Shows Windows privacy and telemetry settings in one list, with a recommendation for each."/>

        <CheckBox x:Name="EnableCheck" Style="{StaticResource EnableToggle}" IsChecked="True" Content="Run O&amp;O ShutUp10++"/>
        <TextBlock x:Name="UnavailableNote" Style="{StaticResource Muted}" Visibility="Collapsed"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What it does" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Each setting is a switch with a green (recommended), yellow (limited recommendation) or red (not recommended) mark. One click on 'Actions > Apply only recommended settings' covers most people. It is portable: nothing is installed."/>
                <TextBlock Text="What it changes" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Windows privacy, telemetry and app-permission settings (registry values, policies and some services)."/>
                <TextBlock Text="Risks" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Red and some yellow settings can turn off features you use (for example Windows Update options, OneDrive or the Microsoft Store). Stick to the recommended ones if you are unsure."/>
                <TextBlock Text="How to undo" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Open ShutUp10++ again and use 'Actions > Undo all changes', or use UDP's restore point."/>
            </StackPanel>
        </Border>

        <TextBlock Text="Mode" Style="{StaticResource SectionTitle}"/>
        <RadioButton x:Name="ModeGui" GroupName="OOSUMode" IsChecked="True" Content="Open ShutUp10++ and choose the settings myself (recommended)"/>
        <TextBlock Style="{StaticResource Muted}" Margin="22,0,0,6"
                   Text="UDP shows a short guide, opens ShutUp10++ and continues automatically when you close it."/>
        <RadioButton x:Name="ModeSilent" GroupName="OOSUMode" Content="Apply my exported settings silently"/>
        <TextBlock x:Name="SilentNote" Style="{StaticResource Muted}" Margin="22,0,0,6"/>

        <Border Style="{StaticResource InfoBox}">
            <TextBlock Style="{StaticResource Body}" Margin="0"
                       Text="UDP does not ship a settings file, because O&amp;O does not publish the file format. To use silent mode: run ShutUp10++ once in GUI mode, set it up the way you like, use 'File > Export settings', and save the file as config\ooshutup10.cfg in the UDP folder. UDP then runs: OOSU10.exe ooshutup10.cfg /quiet"/>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="Source: oo-software.com (freeware). The download must be signed by O&amp;O Software GmbH, otherwise the step is skipped."/>
    </StackPanel>
</ScrollViewer>
